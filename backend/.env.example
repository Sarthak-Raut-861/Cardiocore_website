# CardioCoreEdge Backend Environment Configuration (Example)
# Copy this file to .env for local development.

PROJECT_NAME="CardioCoreEdge API"
VERSION="0.1.0"
ENVIRONMENT=development

# Security: Provide a cryptographically secure random string in production
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-secret

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./cardiocore_dev.db

# Ephemeral/Mock Redis URL
REDIS_URL=redis://localhost:6379/0

# Allowed CORS Origins (JSON list or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
